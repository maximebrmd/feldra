{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": [
      "!!node_modules",
      "!!.next",
      "!!packages/feldra/template",
      "!!drizzle/meta",
      "!!.agents",
      "!!skills-lock.json",
      "!!package-lock.json",
      "!!test-results",
      "!!playwright-report",
      "!!**/.next",
      "!!**/.turbo",
      "!!packages/database/drizzle/meta",
      "!!my-new-saas",
      "!!**/.astro",
      "!!**/.blume",
      "!!**/dist"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "scripts/**",
        "packages/feldra/bin/**",
        "tests/**",
        "packages/database/scripts/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "performance": {
            "noAwaitInLoops": "off",
            "useTopLevelRegex": "off",
            "noDelete": "off"
          },
          "style": {
            "useDestructuring": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/docs/**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          },
          "suspicious": {
            "noEmptySource": "off"
          },
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/docs/src/styles/*.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "performance": {
        "noJsxPropsBind": "off"
      }
    }
  }
}
