{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": [
      "!!node_modules",
      "!!.next",
      "!!initializer/template",
      "!!drizzle/meta",
      "!!.agents",
      "!!skills-lock.json",
      "!!package-lock.json",
      "!!test-results",
      "!!playwright-report"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**", "initializer/bin/**", "tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "performance": {
            "noAwaitInLoops": "off",
            "useTopLevelRegex": "off",
            "noDelete": "off"
          },
          "style": {
            "useDestructuring": "off"
          }
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "performance": {
        "noJsxPropsBind": "off"
      }
    }
  }
}
