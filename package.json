{
  "name": "saas-keel",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "dev": "next dev",
    "format": "ultracite fix",
    "initializer:pack": "node scripts/pack-initializer.mjs",
    "initializer:test": "node scripts/test-initializer.mjs",
    "lint": "ultracite check",
    "start": "next start",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:browser": "node scripts/test-browser.mjs",
    "test:database": "node scripts/test-database.mjs",
    "test:integration": "node --conditions=react-server --import tsx --test tests/integration/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.4",
    "@radix-ui/react-slot": "1.3.3",
    "better-auth": "1.7.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.28.0",
    "server-only": "0.0.1",
    "stripe": "22.6.2",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "ultracite": "7.11.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
