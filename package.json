{
  "name": "feldra-monorepo",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/docs",
    "packages/feldra"
  ],
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "docs:build": "bun run --filter docs build",
    "docs:dev": "bun run --filter docs dev",
    "docs:translate": "bun run --filter docs translate --",
    "docs:translations:check": "bun run --filter docs translate:check",
    "format": "ultracite fix",
    "initializer:pack": "node scripts/pack-initializer.mjs",
    "initializer:test": "node scripts/test-initializer.mjs",
    "lint": "ultracite check",
    "release:sync": "node scripts/sync-release-version.mjs",
    "release:version": "bun run changeset version && bun run release:sync",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:coverage": "node --conditions=react-server --import tsx --test --experimental-test-coverage tests/*.test.ts",
    "test:docs": "node --import tsx scripts/test-docs.mjs",
    "test:initializer": "node --test tests/initializer/*.test.mjs",
    "typecheck": "turbo run typecheck && tsc --noEmit"
  },
  "overrides": {
    "@scalar/astro": {
      "astro": "7.3.2"
    },
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "lodash-es": "4.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@changesets/cli": "3.0.2",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "ultracite": "7.11.1",
    "yaml": "2.9.1"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
