# Copy to .env.local. Empty provider values deliberately fail validation on use.
# Each derived project MUST use independent provider resources and secrets.
WEB_URL=http://localhost:3000
APP_URL=http://localhost:3001
BETTER_AUTH_SECRET=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
RESEND_API_KEY=
EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# false for a Stripe sandbox; true only with live keys, price and webhook.
STRIPE_LIVE_MODE=false
